# Creating an LMEM 
model <- lmer(log(daly_pop_risk) ~ 1 + pop65 + gdp + male + year +
                (1 + year | location),
              data=part,
              control = lmerControl(optimizer = "bobyqa", calc.derivs = FALSE, optCtrl = list(maxfun = 1e5)))

summary(model)

# Doing likelihood-ratio test:
model_2 <- lmer(log(daly_pop) ~ 1 + pop65 + gdp + male + year +
                  (1 + year | location),
                data=Finaldataset_MPH,
                control = lmerControl(optimizer = "bobyqa", calc.derivs = FALSE, optCtrl = list(maxfun = 1e5)))
anova(model, model_2)


# Extracting random effects
ranef_4 <- ranef(model)
ranef_4 <- as.data.frame(ranef_4$location)
ranef_4$location <- row.names(model)

ranef_4$year <- ranef_4$year + fixef(model)[8]


random_effect <- left_join(world_map, ranef_4, by = c("region" = "location"))


