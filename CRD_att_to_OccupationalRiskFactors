# Turning death and daly rates based on 1 million of population
a <- numeric(nrow(Finaldataset_MPH))
b <- numeric(nrow(Finaldataset_MPH))
c <- numeric(nrow(Finaldataset_MPH))
for (i in 1:nrow(Finaldataset_MPH)) {
  a[i] <- as.numeric(Finaldataset_MPH$crd_death[i])
  b[i] <- as.numeric(Finaldataset_MPH$pop[i])
  c[i] <- as.numeric(Finaldataset_MPH$crd_daly[i])
  Finaldataset_MPH$death_pop[i] <- (a[i]/b[i]) * 1000000
  Finaldataset_MPH$daly_pop[i] <- (c[i]/b[i]) * 1000000
  
}

